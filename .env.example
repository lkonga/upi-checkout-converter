# Optional API auth for service mode
CHECKOUT_CONVERTER_API_KEY=change-me

# Optional outbound proxy for OpenAI checkout request
# OPENAI_PROXY_URL=socks5h://user:pass@host:port

PORT=8080
BIND_HOST=0.0.0.0
REQUEST_TIMEOUT_SECONDS=30
MAX_OUTBOUND_CONCURRENCY=50
SESSION_MAX_CLIENTS=100
IMPERSONATE_BROWSER=chrome136
FALLBACK_IMPERSONATE_BROWSER=chrome133a
